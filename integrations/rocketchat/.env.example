# Rocket.Chat bridge config — copy to a private .env (gitignored), never commit real values.
# Load with:  set -a; source integrations/rocketchat/.env; set +a

RC_URL="https://your-rocketchat.example.com"
RC_USER="your-login"
RC_PASS="your-password"
RC_CHANNEL="saleswiki-demo"

# Optional
# RC_TRIGGER="?"
# RC_POLL="2"
# SALESWIKI_DEMO_VAULT="/path/to/permissioned-vault"
# RC_USE_MCP="1"   # route reads through the real MCP server (run bridge under .venv/bin/python)
